{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/schemas/v1.0/provenance.schema.json",
  "title": "DADC V1.0 Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_type", "schema_version", "provenance_id", "subject_refs", "source_type", "software", "scripts", "people", "generated_at"],
  "properties": {
    "entity_type": {"const": "Provenance"},
    "schema_version": {"const": "1.0"},
    "provenance_id": {"type": "string", "minLength": 3},
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_type", "entity_id"],
        "properties": {
          "entity_type": {"enum": ["Device", "DesignRevision", "Study", "Run", "Observable", "Metric", "Artifact", "Validation", "Provenance"]},
          "entity_id": {"type": "string", "minLength": 3}
        }
      }
    },
    "source_type": {"enum": ["generated", "simulation", "experiment", "literature", "data_processing", "manual_entry", "imported"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "title"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["doi", "url", "report", "datasheet", "file", "person"]},
          "title": {"type": "string", "minLength": 1},
          "citation": {"type": "string"},
          "uri": {"type": "string"},
          "license": {"type": "string"},
          "accessed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "software": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "role"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "scripts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["person_id", "role"],
        "properties": {
          "person_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}

