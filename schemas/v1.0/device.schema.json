{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/schemas/v1.0/device.schema.json",
  "title": "DADC V1.0 Device",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_type", "schema_version", "device_id", "name", "device_class", "device_subtype", "physics_domains", "profile_schema", "extensions"],
  "properties": {
    "entity_type": {"const": "Device"},
    "schema_version": {"const": "1.0"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{2,127}$"},
    "name": {"type": "string", "minLength": 1},
    "device_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "device_subtype": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "physics_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["electromagnetics", "thermal", "structural", "acoustics", "fluid", "optical", "quantum", "chemical"]}
    },
    "profile_schema": {"type": "string", "pattern": "^device_profiles/[A-Za-z0-9_.-]+\\.schema\\.json$"},
    "extensions": {"type": "object", "minProperties": 1},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}

