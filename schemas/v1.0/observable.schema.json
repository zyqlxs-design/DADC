{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/schemas/v1.0/observable.schema.json",
  "title": "DADC V1.0 Observable",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_type", "schema_version", "observable_id", "run_id", "observable_type", "quantity", "axes", "components", "complex_representation", "data_ref", "artifact_id", "coordinate_system_ref", "value_origin", "provenance_id"],
  "properties": {
    "entity_type": {"const": "Observable"},
    "schema_version": {"const": "1.0"},
    "observable_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "observable_type": {"enum": ["s_parameters", "curve", "scalar", "field", "response", "table"]},
    "quantity": {"type": "string", "minLength": 1},
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "data_ref"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "data_ref": {"type": "string", "pattern": "^[^:]+\\.h5:/.*$"}
        }
      }
    },
    "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "complex_representation": {"enum": ["real_imaginary", "not_applicable"]},
    "data_ref": {"type": "string", "pattern": "^[^:]+\\.h5:/.*$"},
    "artifact_id": {"type": "string", "minLength": 3},
    "coordinate_system_ref": {"type": ["string", "null"]},
    "value_origin": {"enum": ["raw_solver_output", "raw_experiment_output", "literature_extracted", "calculated", "manual_entry"]},
    "provenance_id": {"type": "string", "minLength": 3},
    "derived_from_observable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "script_artifact_id"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "script_artifact_id": {"type": "string", "minLength": 3}
      }
    },
    "manual_entry_context": {"type": "object", "minProperties": 1},
    "field_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_system_ref", "coordinate_unit", "mesh_type", "components", "condition", "data_ref", "normalization"],
      "properties": {
        "coordinate_system_ref": {"type": "string", "minLength": 1},
        "coordinate_unit": {"type": "string", "minLength": 1},
        "mesh_type": {"enum": ["structured", "unstructured", "surface", "point_cloud"]},
        "components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "unit"],
          "properties": {
            "kind": {"enum": ["frequency", "time", "steady_state"]},
            "value": {"type": ["number", "string"]},
            "unit": {"type": "string", "minLength": 1}
          }
        },
        "data_ref": {"type": "string", "pattern": "^[^:]+\\.h5:/.*$"},
        "normalization": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"quantity": {"pattern": "^complex_"}}}, "then": {"properties": {"complex_representation": {"const": "real_imaginary"}}}},
    {"if": {"properties": {"observable_type": {"const": "field"}}}, "then": {"required": ["field_metadata"], "properties": {"coordinate_system_ref": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"value_origin": {"const": "calculated"}}}, "then": {"required": ["derived_from_observable_ids", "derivation"]}},
    {"if": {"properties": {"value_origin": {"const": "manual_entry"}}}, "then": {"required": ["manual_entry_context"]}}
  ]
}
