{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/schemas/v1.0/study.schema.json",
  "title": "DADC V1.0 Study",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_type", "schema_version", "study_id", "device_id", "design_revision_ids", "study_type", "physics_domains", "run_ids", "created_at"],
  "properties": {
    "entity_type": {"const": "Study"},
    "schema_version": {"const": "1.0"},
    "study_id": {"type": "string", "minLength": 3},
    "device_id": {"type": "string", "minLength": 3},
    "design_revision_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "study_type": {"enum": ["parameter_sweep", "optimization", "comparison", "validation"]},
    "physics_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "objectives": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "parameter_space": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "coupling_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_run_id", "target_run_id", "coupling_type", "transferred_observable_ids", "mapping_artifact_id"],
        "properties": {
          "source_run_id": {"type": "string", "minLength": 3},
          "target_run_id": {"type": "string", "minLength": 3},
          "coupling_type": {"enum": ["one_way", "two_way", "co_simulation"]},
          "transferred_observable_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "mapping_artifact_id": {"type": "string", "minLength": 3}
        }
      }
    },
    "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}

