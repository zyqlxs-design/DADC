{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/schemas/v1.0/device_profiles/inductor.schema.json",
  "title": "Inductor device extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["inductor"],
  "properties": {
    "inductor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "part_number",
        "construction",
        "package_size",
        "port_count",
        "datasheet_specifications"
      ],
      "properties": {
        "manufacturer": {"type": "string", "minLength": 1},
        "part_number": {"type": "string", "minLength": 1},
        "construction": {"type": "string", "minLength": 1},
        "package_size": {"type": "string", "minLength": 1},
        "port_count": {"const": 2},
        "datasheet_specifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "property",
              "value",
              "unit",
              "qualifier",
              "test_conditions",
              "value_origin",
              "source_artifact_id"
            ],
            "properties": {
              "property": {"type": "string", "minLength": 1},
              "value": {"type": "number"},
              "unit": {"type": "string", "minLength": 1},
              "qualifier": {
                "enum": ["nominal", "minimum", "maximum", "typical"]
              },
              "tolerance": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value", "unit"],
                "properties": {
                  "kind": {"enum": ["plus_minus", "upper", "lower"]},
                  "value": {"type": "number", "minimum": 0},
                  "unit": {"type": "string", "minLength": 1}
                }
              },
              "test_conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["quantity", "value", "unit"],
                  "properties": {
                    "quantity": {"type": "string", "minLength": 1},
                    "value": {"type": ["number", "string"]},
                    "unit": {"type": "string", "minLength": 1}
                  }
                }
              },
              "value_origin": {"const": "literature_extracted"},
              "source_artifact_id": {"type": "string", "minLength": 3}
            }
          }
        }
      }
    }
  }
}
