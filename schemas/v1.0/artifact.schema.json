{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/schemas/v1.0/artifact.schema.json",
  "title": "DADC V1.0 Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_type", "schema_version", "artifact_id", "subject_refs", "artifact_role", "relative_path", "sha256", "size_bytes", "media_type", "immutable", "value_origin", "provenance_id", "created_at"],
  "properties": {
    "entity_type": {"const": "Artifact"},
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 3},
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_type", "entity_id"],
        "properties": {
          "entity_type": {"enum": ["Device", "DesignRevision", "Study", "Run", "Observable", "Metric", "Artifact", "Validation", "Provenance"]},
          "entity_id": {"type": "string", "minLength": 3}
        }
      }
    },
    "artifact_role": {"enum": ["native_project", "raw_input", "mesh", "solver_log", "script", "result_hdf5", "index_parquet", "validation_evidence", "report", "measurement_data", "literature_source"]},
    "relative_path": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))"}},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "media_type": {"type": "string", "minLength": 1},
    "immutable": {"type": "boolean"},
    "value_origin": {"enum": ["raw_solver_output", "raw_experiment_output", "literature_extracted", "calculated", "manual_entry"]},
    "provenance_id": {"type": "string", "minLength": 3},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"artifact_role": {"enum": ["native_project", "raw_input", "solver_log", "result_hdf5", "measurement_data", "literature_source"]}}},
      "then": {"properties": {"immutable": {"const": true}}}
    }
  ]
}
