{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/schemas/v1.0/metric.schema.json",
  "title": "DADC V1.0 Metric",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity_type", "schema_version", "metric_id", "run_id", "name", "quantity", "value", "unit", "value_origin", "source_observable_ids", "extraction_method", "provenance_id"],
  "properties": {
    "entity_type": {"const": "Metric"},
    "schema_version": {"const": "1.0"},
    "metric_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 1},
    "quantity": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "string", "boolean"]},
    "unit": {"type": "string", "minLength": 1},
    "value_origin": {"enum": ["raw_solver_output", "raw_experiment_output", "literature_extracted", "calculated", "manual_entry"]},
    "source_observable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "extraction_method": {"type": "string", "minLength": 1},
    "calculation": {"type": "object", "minProperties": 1},
    "manual_entry_context": {"type": "object", "minProperties": 1},
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "coverage"],
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string"},
        "coverage": {"type": "string"}
      }
    },
    "provenance_id": {"type": "string", "minLength": 3}
  },
  "allOf": [
    {"if": {"properties": {"value_origin": {"const": "calculated"}}}, "then": {"required": ["calculation"]}},
    {"if": {"properties": {"value_origin": {"const": "manual_entry"}}}, "then": {"required": ["manual_entry_context"]}}
  ]
}

