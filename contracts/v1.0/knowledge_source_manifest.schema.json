{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/contracts/v1.0/knowledge_source_manifest.schema.json",
  "title": "DADC controlled documentation source manifest V1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["knowledge_manifest_version", "corpus_id", "retrieved_at", "documents"],
  "properties": {
    "knowledge_manifest_version": {"const": "1.0"},
    "corpus_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "allowed_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
    "max_bytes_per_document": {"type": "integer", "minimum": 1024, "maximum": 20000000},
    "chunk_max_characters": {"type": "integer", "minimum": 256, "maximum": 20000},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "url", "source_type", "product", "product_version", "license"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
          "url": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["official_documentation", "official_example", "local_fixture"]},
          "product": {"type": "string", "minLength": 1},
          "product_version": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
