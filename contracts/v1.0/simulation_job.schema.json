{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/contracts/v1.0/simulation_job.schema.json",
  "title": "DADC controlled simulation job V1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["simulation_job_version", "job_id", "trial_kind", "parameters", "objective", "backend"],
  "properties": {
    "simulation_job_version": {"const": "1.0"},
    "job_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
    "trial_kind": {"enum": ["search", "independent_verification"]},
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantity", "unit", "goal"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "quantity": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "goal": {"enum": ["minimize", "maximize", "target"]},
        "target": {"type": "number"}
      },
      "allOf": [
        {"if": {"properties": {"goal": {"const": "target"}}}, "then": {"required": ["target"]}}
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "options"],
      "properties": {
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "options": {"type": "object"}
      }
    }
  }
}
