{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dadc.example/contracts/v1.0/agent_tuning_request.schema.json",
  "title": "DADC bounded agent tuning request V1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_tuning_request_version",
    "request_id",
    "created_at",
    "user_goal",
    "device_class",
    "knowledge_query",
    "knowledge_top_k",
    "plan_template",
    "parameter_policy",
    "acceptance"
  ],
  "properties": {
    "agent_tuning_request_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "user_goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "device_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "knowledge_query": {"type": "string", "minLength": 1, "maxLength": 2000},
    "knowledge_top_k": {"type": "integer", "minimum": 1, "maximum": 20},
    "plan_template": {"type": "string", "minLength": 1},
    "parameter_policy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "allowed_values", "max_selected_values"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "unit": {"type": "string", "minLength": 1},
          "allowed_values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "number"}
          },
          "max_selected_values": {"type": "integer", "minimum": 1}
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "operator",
        "value",
        "unit",
        "require_physical_solver",
        "require_independent_verification"
      ],
      "properties": {
        "quantity": {"type": "string", "minLength": 1},
        "operator": {"enum": ["<=", "<", ">=", ">", "=="]},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "require_physical_solver": {"type": "boolean"},
        "require_independent_verification": {"type": "boolean"}
      }
    }
  }
}
